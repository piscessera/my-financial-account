{
  "name": "my-financial-account",
  "private": true,
  "version": "0.1.0",
  "description": "Personal finance app: annual Thai personal income tax income/expense tracker.",
  "author": "piscessera",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "electron-rebuild -f -w better-sqlite3",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:app": "npm run build && electron-builder",
    "build:dir": "npm run build && electron-builder --dir",
    "preview": "vite preview",
    "pretest": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.36.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.15.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.5"
  }
}
