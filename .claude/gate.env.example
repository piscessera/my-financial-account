# Copy to .claude/gate.env (gitignored) once the stack is decided. Commands run from the repo /
# worktree root. Leave a variable empty to skip that step. Examples:
#   TEST_CMD="php artisan test --compact"        TEST_CMD="npm test -- --run"
#   LINT_CMD="./vendor/bin/pint --test && npx eslint ."
#   SECRETS_CMD="gitleaks detect --no-banner --redact"   (or: git diff --cached | grep -Ei 'api[_-]?key|secret|password' && exit 1 || true)
TEST_CMD=""
LINT_CMD=""
SECRETS_CMD=""
